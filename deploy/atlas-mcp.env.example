ATLAS_VAULT=/srv/atlas/vault
ATLAS_MCP_PORT=4320
ATLAS_MCP_MAX_NOTE_BYTES=16777216
ATLAS_MCP_CLIENTS_FILE=/etc/atlas-mcp/clients.json
# Replace with the approved HTTPS hostname; no scheme, port or wildcard.
ATLAS_MCP_ALLOWED_HOSTS=127.0.0.1,localhost,mcp.example.com
# Leave unset for server-to-server clients. Browser origins require explicit approval.
# ATLAS_MCP_ALLOWED_ORIGINS=https://approved-client.example.com
